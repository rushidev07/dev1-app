                    <h2 style="font-size:17px; font-weight:700; color:#1d1d1f; margin-bottom:16px;">Popular Searches</h2>
                    <div class="popular-searches-row">
                        <template x-for="term in popularSearches" :key="term">
                            <button type="button"
                                    @click="searchExact(term)"
                                    style="display:inline-flex; align-items:center; gap:6px; padding:8px 16px; border:1px solid #d2d2d7; border-radius:999px; background:#fff; color:#1d1d1f; font-size:13px; white-space:nowrap; transition:box-shadow 0.2s; cursor:pointer;"
                                    onmouseover="this.style.boxShadow='0 2px 8px rgba(0,0,0,0.1)'"
                                    onmouseout="this.style.boxShadow='none'">
                                <span x-text="term"></span>
                            </button>
                        </template>
                    </div>
                </div>
            </div>

            <!-- Desktop product grid -->
            <div x-show="!loading && results.length > 0" class="hidden md:grid grid-cols-2 xl:grid-cols-3 gap-0.5">
                <template x-for="(product, index) in sortedResults()" :key="product.sku || product.product_id">
                    <div class="bg-white relative flex flex-col group">

                        <!-- Stock badge -->
                        <div class="absolute left-3 top-3 z-10"
                             x-show="product.variants && product.variants.length <= 10 && product.variants.length > 0">
                            <span class="rounded border-2 border-ahy-stock-green bg-white px-2 py-1 text-xs font-semibold text-ahy-stock-green"
                                  x-text="(product.variants || []).length + ' Left'"></span>
                        </div>

                        <!-- Bookmark -->
                        <button @click.prevent="addToWishlistModal(product.product_id)"
                                :disabled="wishLoading[product.product_id]"
                                aria-label="Add to Wish List" type="button"
                                class="absolute top-2.5 right-2.5 z-10 w-9 h-9 rounded-full border border-gray-300 bg-white flex items-center justify-center text-ahy-blue hover:text-red-500 shadow-sm transition">
                            <template x-if="wishLoading[product.product_id]">
                                <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 22 6.477 22 12h-4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/></svg>
                            </template>
                            <template x-if="!wishLoading[product.product_id]">
                                <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15.91 20" fill="currentColor">
                                    <path d="M14.41,1.5v16L9.27,12.71a1.62,1.62,0,0,0-2.19,0L1.5,17.58V1.5H14.41M14.76,0H1.15A1.16,1.16,0,0,0,0,1.15v18.1a.74.74,0,0,0,1.24.56l6.83-6a.12.12,0,0,1,.18,0l6.38,5.9a.74.74,0,0,0,.52.21.76.76,0,0,0,.76-.77v-18A1.15,1.15,0,0,0,14.76,0Z"/>
                                </svg>
                            </template>
                        </button>

                        <!-- Image -->
                        <a :href="product.url_key ? '/' + product.url_key + '.html' : '#'" class="block overflow-hidden" style="height:244px">
                            <img :src="imgUrl(product.image)"
                                 :alt="product.name"
                                 width="244" height="244"
                                 class="object-contain object-center p-3"
                                 :style="{ opacity: isFallbackImg(product.image) ? 0.45 : 1 }"
                                 style="width:244px;height:244px;margin:0 auto;display:block"
                                 loading="eager"
                                 fetchpriority="high"
                                 @error="handleImgError($event)"
                                 :data-original-src="product.image"/>
                        </a>

                        <!-- Info -->
                        <div class="flex flex-col flex-1 px-4 pb-4">

                            <!-- Name -->
                            <a :href="product.url_key ? '/' + product.url_key + '.html' : '#'"
                               class="line-clamp-2 !text-lg !font-extrabold text-ahy-blue leading-normal mt-1 h-[3.4rem]"
                               :title="product.name" x-html="product.name"></a>

                            <!-- Seller -->
                            <p class="text-xs text-gray-500 mt-1"
                               x-text="'Sold By ' + (product.brand || 'The Everest Marketplace')"></p>

                            <!-- Price -->
                            <div class="AhyPrice min-h-[5.5rem] flex flex-col !overflow-visible mt-1">
                                <template x-if="product.price && product.special_price && product.special_price < product.price">
                                    <div>
                                        <div class="text-ahy-red text-xs font-bold uppercase">Deal</div>
                                        <div class="flex items-baseline gap-2">
                                            <span class="text-2xl font-extrabold text-ahy-blue" x-html="hyva.formatPrice(product.special_price)"></span>
                                            <span class="text-sm text-gray-400 line-through" x-html="hyva.formatPrice(product.price)"></span>
                                        </div>
                                    </div>
                                </template>
                                <template x-if="product.price && (!product.special_price || product.special_price >= product.price)">
                                    <div class="flex flex-col items-baseline">
                                        <span class="capitalize text-ahy-red !font-bold !text-sm">From</span>
                                        <span class="text-2xl font-extrabold text-ahy-blue" x-html="hyva.formatPrice(product.price)"></span>
                                    </div>
                                </template>
                                <template x-if="!product.price">
                                    <span class="capitalize !flex justify-center items-center w-full !rounded-full !bg-transparent !text-ahy-blue hover:shadow-[#0d2f47_0px_0px_0px_1px_inset] !text-sm !py-1.5 !px-2.5 font-bold !border-2 !border-ahy-blue">See Options</span>
                                </template>
                            </div>

                            <div class="flex items-center justify-between">
                                <p class="capitalize !text-gray-900 !font-semibold !text-sm text-nowrap">FREE Shipping</p>
                                <div class="w-full mt-auto pt-3 max-w-[160px]">
                                    <template x-if="product.type !== 'configurable'">
                                        <button @click.prevent="addSimpleToCart(product)"
                                                :class="cartLoading[product.product_id] === true ? 'opacity-60 pointer-events-none' : ''"
                                                class="capitalize kuBtnDark !flex justify-center items-center gap-2 w-full !rounded-full !bg-transparent !text-ahy-blue hover:shadow-[#0d2f47_0px_0px_0px_1px_inset] !text-sm !py-1.5 !px-2.5 font-bold !border-2 !border-ahy-blue AhyLandingAddToCartBtn">
                                            <svg x-show="cartLoading[product.product_id] === true" class="animate-spin w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 22 6.477 22 12h-4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/></svg>
                                            <svg x-show="cartLoading[product.product_id] !== true" class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                                            <span x-text="cartLoading[product.product_id] === true ? 'Adding…' : 'Add'"></span>
                                        </button>
                                    </template>
                                    <template x-if="product.type === 'configurable'">
                                        <button @click.prevent="window.dispatchEvent(new CustomEvent('ahy-open-config-modal', {detail: product, bubbles: true}))"
                                                class="capitalize kuBtnDark !flex justify-center items-center w-full !rounded-full !bg-transparent !text-ahy-blue hover:shadow-[#0d2f47_0px_0px_0px_1px_inset] !text-sm !py-1.5 !px-2.5 font-bold !border-2 !border-ahy-blue AhyLandingAddToCartBtn">
                                            Options
                                        </button>
                                    </template>
                                </div>
                            </div>
                        </div>
                    </div>
                </template>
            </div>

            <!-- Mobile product list (< 640px horizontal, 640–768px padded) -->
            <div x-show="!loading && results.length > 0" class="md:hidden flex flex-col gap-0.5">
                <template x-for="(product, index) in sortedResults()" :key="'m-' + (product.sku || product.product_id)">
                    <!-- edge-to-edge below 640px, padded + max-w-[640px] above -->
                    <div class="relative flex bg-white ahy-mobile-card">

                        <!-- Image column -->
                        <div class="relative shrink-0" style="width:45%">
                            <div class="absolute top-3 left-3 z-10"
                                 x-show="product.variants && product.variants.length <= 10 && product.variants.length > 0">
                                <span class="rounded border-2 border-ahy-stock-green bg-white px-2 py-0.5 text-xs font-semibold text-ahy-stock-green"
                                      x-text="(product.variants || []).length + ' Left'"></span>
                            </div>
                            <a :href="product.url_key ? '/' + product.url_key + '.html' : '#'" class="block h-full">
                                <img :src="imgUrl(product.image)"
                                     :alt="product.name"
                                     class="w-full h-full object-contain p-3"
                                     :style="{ opacity: isFallbackImg(product.image) ? 0.45 : 1 }"
                                     style="min-height:160px;max-height:200px"
                                     loading="eager"
                                     fetchpriority="high"
                                     @error="handleImgError($event)" :data-original-src="product.image"/>
                            </a>
                        </div>

                        <!-- Info column -->
                        <div class="flex-1 min-w-0 flex flex-col px-3 py-4">
                            <a :href="product.url_key ? '/' + product.url_key + '.html' : '#'"
                               class="font-bold text-ahy-blue leading-snug line-clamp-3" style="font-size:15px"
                               x-html="product.name"></a>
                            <p class="text-xs text-gray-500 mt-1"
                               x-text="'Sold By ' + (product.brand || 'The Everest Marketplace')"></p>
                            <div class="mt-2">
                                <template x-if="product.price && product.special_price && product.special_price < product.price">
                                    <div>
                                        <div class="text-ahy-red text-sm font-bold">Deal</div>
                                        <div class="flex items-baseline gap-2">
                                            <span class="text-xl font-extrabold text-ahy-blue" x-html="hyva.formatPrice(product.special_price)"></span>
                                            <span class="text-sm text-gray-400 line-through" x-html="hyva.formatPrice(product.price)"></span>
                                        </div>
                                    </div>
                                </template>
                                <template x-if="product.price && (!product.special_price || product.special_price >= product.price)">
                                    <div>
                                        <span class="text-ahy-red text-sm font-bold">From</span>
                                        <div class="text-xl font-extrabold text-ahy-blue" x-html="hyva.formatPrice(product.price)"></div>
                                    </div>
                                </template>
                            </div>
                            <p class="text-sm text-gray-900 font-semibold mt-2">FREE Shipping</p>
                            <div class="flex items-center gap-2 mt-3">
                                <template x-if="product.type !== 'configurable'">
                                    <button @click.prevent="addSimpleToCart(product)"
                                            :class="cartLoading[product.product_id] === true ? 'opacity-60 pointer-events-none' : ''"
                                            class="flex items-center gap-2 border-2 border-ahy-blue text-ahy-blue rounded-full px-5 py-2 text-sm font-bold">
                                        <svg x-show="cartLoading[product.product_id] === true" class="animate-spin w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 22 6.477 22 12h-4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/></svg>
                                        <svg x-show="cartLoading[product.product_id] !== true" class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                                        <span x-text="cartLoading[product.product_id] === true ? 'Adding…' : 'Add'"></span>
                                    </button>
                                </template>
                                <template x-if="product.type === 'configurable'">
                                    <button @click.prevent="window.dispatchEvent(new CustomEvent('ahy-open-config-modal', {detail: product, bubbles: true}))"
                                            class="flex items-center gap-2 border-2 border-ahy-blue text-ahy-blue rounded-full px-5 py-2 text-sm font-bold">
                                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
                                        Options
                                    </button>
                                </template>
                                <button @click.prevent="addToWishlistModal(product.product_id)"
                                        :disabled="wishLoading[product.product_id]"
                                        class="w-9 h-9 shrink-0 rounded-full border border-gray-300 bg-white flex items-center justify-center text-ahy-blue hover:text-red-500">
                                    <template x-if="wishLoading[product.product_id]">
                                        <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 22 6.477 22 12h-4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/></svg>
                                    </template>
                                    <template x-if="!wishLoading[product.product_id]">
                                        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15.91 20" fill="currentColor">
                                            <path d="M14.41,1.5v16L9.27,12.71a1.62,1.62,0,0,0-2.19,0L1.5,17.58V1.5H14.41M14.76,0H1.15A1.16,1.16,0,0,0,0,1.15v18.1a.74.74,0,0,0,1.24.56l6.83-6a.12.12,0,0,1,.18,0l6.38,5.9a.74.74,0,0,0,.52.21.76.76,0,0,0,.76-.77v-18A1.15,1.15,0,0,0,14.76,0Z"/>
                                        </svg>
                                    </template>
                                </button>
                            </div>
                        </div>
                    </div>
                </template>
            </div>

            <!-- Pagination -->
            <div x-show="!loading && totalPages > 1" class="flex justify-center items-center gap-8 pt-10 pb-4">
                <button aria-label="Previous" :disabled="page <= 1"
                        @click="page > 1 && goToPage(page - 1)"
                        class="bg-white shadow-lg rounded-full w-12 h-12 flex items-center justify-center border border-gray-200"
                        :class="page <= 1 ? 'opacity-30 cursor-not-allowed' : 'hover:border-ahy-blue'">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                </button>
                <div x-data="{ open: false }" class="relative">
                    <button @click="open = !open" class="font-bold text-ahy-blue flex items-center gap-1">
                        Page <span x-text="page"></span> of <span x-text="totalPages"></span>
                        <svg class="w-4 h-4 ml-1 transition-transform" :class="open ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <nav x-show="open" @click.outside="open = false"
                         class="absolute bottom-8 left-1/2 -translate-x-1/2 bg-white border border-gray-200 rounded-xl shadow-lg z-20 w-36 max-h-52 overflow-auto py-1">
                        <template x-for="p in totalPages" :key="p">
                            <button class="w-full text-center px-4 py-2.5 text-sm hover:bg-gray-50"
                                    :class="p === page ? 'font-bold text-ahy-blue' : ''"
                                    @click="goToPage(p); open = false"
                                    x-text="'Page ' + p"></button>
                        </template>
                    </nav>
                </div>
                <button aria-label="Next" :disabled="page >= totalPages"
                        @click="page < totalPages && goToPage(page + 1)"
                        class="bg-white shadow-lg rounded-full w-12 h-12 flex items-center justify-center border border-gray-200"
                        :class="page >= totalPages ? 'opacity-30 cursor-not-allowed' : 'hover:border-ahy-blue'">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </button>
            </div>

        </div><!-- /.flex-1 -->
    </div><!-- /.flex -->


</div><!-- #ahyModal -->
</div><!-- .columns -->
