<?php
/**
 * Product rows for the discount alert email.
 *
 * @var \Ahy\DiscountAlert\Block\Email\ProductsTable $block
 * @var \Magento\Framework\Escaper $escaper
 */
$cell        = 'padding:11px 14px;border-bottom:1px solid #EFEADD;';
$discountHue = '#EF4444';
?>
<?php foreach ($block->getRows() as $row): ?>
    <tr style="background:#FFFFFF;">
        <td style="<?= /* @noEscape */ $cell ?>color:#0D2E47;font-size:11px;font-weight:600;white-space:nowrap;letter-spacing:0.2px;">
            <?= $escaper->escapeHtml($row['sku']) ?>
        </td>
        <td style="<?= /* @noEscape */ $cell ?>color:#0D2E47;font-size:12px;">
            <?= $escaper->escapeHtml($row['name']) ?>
        </td>
        <td style="text-align:right;<?= /* @noEscape */ $cell ?>color:#0D2E47;font-size:12px;">
            <?= $escaper->escapeHtml($row['price']) ?>
        </td>
        <td style="text-align:right;<?= /* @noEscape */ $cell ?>color:#0D2E47;font-size:12px;font-weight:600;">
            <?= $escaper->escapeHtml($row['special_price']) ?>
        </td>
        <td style="text-align:right;<?= /* @noEscape */ $cell ?>font-weight:700;font-size:12px;color:<?= $escaper->escapeHtmlAttr($discountHue) ?>;">
            <?= $escaper->escapeHtml($row['discount']) ?>
        </td>
    </tr>
<?php endforeach; ?>
