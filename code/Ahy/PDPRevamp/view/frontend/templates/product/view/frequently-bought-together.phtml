<?php
/**
 * PDP "Frequently Bought Together" section. Suggestions are algorithmic
 * (same category as the current product - see
 * Ahy\PDPRevamp\Block\Product\View\FrequentlyBoughtTogether), distinct from
 * the merchant-curated Amasty bundle-pack widget shown elsewhere on this
 * page. Renders nothing if the current product has no category or no
 * other products share it.
 */

declare(strict_types=1);

use Ahy\PDPRevamp\Block\Product\View\FrequentlyBoughtTogether;
use Magento\Catalog\Model\Product;
use Magento\Catalog\Model\Product\Type as ProductTypeModel;
use Magento\Framework\Escaper;

/** @var FrequentlyBoughtTogether $block */
/** @var Escaper $escaper */
if (!$block->isEnabled()) {
    return;
}

$items = $block->getBundleItems();
if (count($items) < 2) {
    return;
}

$imageHelper = $block->getImageHelper();
$priceHelper = $block->getPriceHelper();
$sellerHelper = $this->helper('Webkul\Marketplace\Helper\Data');

$discountPercent = $block->getBundleDiscountPercent();

$itemsData = [];
foreach ($items as $item) {
    /** @var Product $item */
    $finalPrice = $block->getItemFinalPrice($item);
    $regularPrice = $block->getItemRegularPrice($item);

    $vendorName = '';
    $sellerData = $sellerHelper->getSellerProductDataByProductId($item->getId());
    if (isset($sellerData->getData()[0]) && $sellerData->getData()[0]) {
        $sellerObj = $sellerData->getData()[0];
        $sellerDataObj = $sellerHelper->getSellerDataBySellerId($sellerObj['seller_id']);
        $sellerInfo = $sellerDataObj->getData()[0] ?? null;
        if ($sellerInfo) {
            $vendorName = $sellerInfo['shop_title'] ?: ($sellerInfo['name'] ?? '');
        }
    }

    $itemsData[] = [
        'id' => (int) $item->getId(),
        'name' => $item->getName(),
        'vendor' => $vendorName,
        'image' => $imageHelper->init($item, 'ahy_fbt_thumbnail')->setImageFile($item->getData('small_image'))->getUrl(),
        'finalPrice' => round($finalPrice, 2),
        'regularPrice' => round($regularPrice, 2),
        'hasDiscount' => $regularPrice > $finalPrice,
        // Suggestions are simple-only (see the block), so this is only ever
        // true for the current product - a configurable PDP still needs the
        // shopper's chosen swatch posted alongside product/qty.
        'requiresOptions' => $item->getTypeId() !== ProductTypeModel::TYPE_SIMPLE,
    ];
}
?>
